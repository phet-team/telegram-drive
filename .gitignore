# ==============================================================================
# Git Ignore for Telegram Cloud Storage Project
# ==============================================================================

# ── Environment & Secrets (NEVER COMMIT SENSITIVE DATA!) ──
.env
.env.*
!.env.example
*.session
*.session-journal

# ── Python / Django ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# Django runtime data
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Virtual Environments
venv/
backend/venv/
env/
ENV/
env.bak/
venv.bak/

# Project storage & chunks cache
backend/temp_chunks/
backend/backups/
backend/ssd_cache/

# ── Frontend (Node / Vite) ──
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# ── IDEs & Operating Systems ──
.idea/
.vscode/
*.swp
*.swo
# ── Private / Production Deployment Specifics (Never push to public repo) ──
docker-compose.prod.yml
audits/
.system_generated/
*.git_private_bak/
.git_private_bak/
**/.git_private_bak/
backend/.github/


