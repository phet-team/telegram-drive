# Django Configuration
DJANGO_SECRET_KEY=generate-a-secure-key-at-least-50-chars-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,your-domain.com

# PostgreSQL Database Configuration
DB_NAME=telegram_drive
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=postgres
DB_PORT=5432

# JWT Authentication
JWT_SECRET_KEY=generate-a-jwt-secret-at-least-32-chars-long
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=7

# Storage Backend: "mock" (dev) or "mtproto" (Telegram MT Protocol client)
STORAGE_BACKEND=mtproto
TELEGRAM_API_ID=0000000
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_telethon_string_session
TELEGRAM_STORAGE_CHAT_ID=-1000000000000
TELEGRAM_BOT_TOKEN=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upload Chunk Size Configuration (in Megabytes)
# Telegram Policy Limits: Min 1 MB (prevents FloodWait), Max 2000 MB (4000 MB for Telegram Premium)
# Recommended for 512MB RAM VPS: 8-32 MB. For powerful dedicated servers: 64-512 MB.
DEFAULT_CHUNK_SIZE_MB=8
MIN_CHUNK_SIZE_MB=4
MAX_CHUNK_SIZE_MB=32

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:5173
