# ==============================================================================
# Telegram Cloud Storage — Community Environment Configuration (.env)
# Copy this file to .env and fill in your credentials before starting Docker Compose.
# ==============================================================================

# ── General Web App ──
PORT=8080
DJANGO_SECRET_KEY=generate-a-random-secret-key-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── PostgreSQL Database ──
# Note: PostgreSQL 16 is required for foreign key cascade and query performance.
DB_NAME=telegram_drive
DB_USER=postgres
DB_PASSWORD=replace-with-a-secure-password
DB_HOST=postgres
DB_PORT=5432

# ── JWT Authentication (Secret must be at least 32 characters) ──
JWT_SECRET_KEY=generate-a-secure-jwt-secret-at-least-32-chars-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── Telegram MTProto Storage Engine (Telethon) ──
# 1. Get TELEGRAM_API_ID and TELEGRAM_API_HASH from https://my.telegram.org
# 2. Run 'python scripts/generate_session.py' to generate your TELEGRAM_SESSION_STRING
STORAGE_BACKEND=mtproto
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_STRING=your_string_session_here

# Target Chat for Storage Chunks:
# Leave blank or set to 'me' to store chunks in your personal 'Saved Messages' (Personal Cloud)
# Or set to a private Channel ID (e.g. -1001234567890)
TELEGRAM_STORAGE_CHAT_ID=me

# ── Optional OAuth & Social Login Providers ──
# If left blank, users can still register and log in with Email/Password. Social login buttons are simply disabled.
# Google OAuth:
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Telegram Login Widget:
# Create a bot via @BotFather. The token verifies widget HMAC, the bot ID initializes the widget.
TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_ID=

# ── Upload Chunk Size Tuning (in Megabytes) ──
# Telegram MTProto Policy Limits: Min 1 MB (prevents FloodWait), Max 2000 MB (4000 MB for Telegram Premium)
# - Small VPS (512MB - 1GB RAM): 8-16 MB
# - Home Server / PC (4GB - 16GB RAM): 32-128 MB
# - High-speed Dedicated Server: 256-500 MB
DEFAULT_CHUNK_SIZE_MB=8
MIN_CHUNK_SIZE_MB=4
MAX_CHUNK_SIZE_MB=32
VITE_CHUNK_SIZE_MB=8

# ── CORS Settings ──
# Comma-separated list of allowed origins (e.g. http://localhost:8080 or your custom domain)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
